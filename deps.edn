{:paths ["src"]
 ;; langgraph-clj brings langchain-clj transitively (both zero-/single-dep,
 ;; all .cljc). Pinned by git coordinate, not a sibling path: this repo is
 ;; standalone and CI checks it out alone, so ../.. never resolves there.
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.com-junkawasaki/langgraph-clj
        {:git/url "https://github.com/kotoba-lang/langgraph.git"
         :git/sha "577a59a9d5eb3ef90b81342f4673973f481ff7f4"}
        ;; Publish bridge (slice d): encode accepted catalogs as i18n-cid
        ;; DAG-CBOR blocks, pin them, admit them to the kotobase-lake plane.
        ;; io.github.<org>/<name> is bare :git/sha — tools.deps infers
        ;; https://github.com/<org>/<name>.git. Pulls io-ipld + kotobase-lake
        ;; transitively.
        io.github.kotoba-lang/i18n-cid
        {:git/sha "f7cda3da863f4c4bbf64ff5bedddf99d2ad5105d"}}
 :aliases
 {:dev {:extra-paths ["test"]}
  ;; the Worker build; the pure core needs none of this, which is the point
  :cljs {:extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}
                      thheller/shadow-cljs {:mvn/version "2.28.20"}}}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/url "https://github.com/cognitect-labs/test-runner"
                       :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]}}}
